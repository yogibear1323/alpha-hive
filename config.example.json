{
  "model": "grok-4.7",
  "temperature": 0.2,
  "max_output_tokens": 1200,
  "api_base": "https://api.x.ai/v1",
  "request_timeout_seconds": 60,
  "reports_dir": "reports",
  "logs_dir": "logs",
  "simulation": {
    "starting_balance_usd": 10000
  },
  "hierarchy": {
    "queen": "decision",
    "scout": "scout",
    "workers": [
      "news",
      "sentiment",
      "charts"
    ],
    "guard": "risk",
    "queen_can_overrule_guard": false,
    "_note": "Risk is the hive's guard and answers to no one. queen_can_overrule_guard must stay false; any other value is refused."
  }
}
