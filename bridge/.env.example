# Alpha Hive bridge settings. Copy to bridge/.env (never commit it; .env is git-ignored).
# The bridge reads these from the process environment first, then from this file.

# --- Crucial Markets TradeLocker login (the same you use at the TradeLocker web/app login) ---
TRADELOCKER_EMAIL=
TRADELOCKER_PASSWORD=
# The server name shown on the TradeLocker login screen for your Crucial account
TRADELOCKER_SERVER=
# Optional: pick one account if the login has several (id from the account switcher, or accNum)
TRADELOCKER_ACCOUNT_ID=
TRADELOCKER_ACC_NUM=
# Optional TradeLocker developer key (higher rate limits)
TRADELOCKER_DEVELOPER_API_KEY=

# --- Backend: demo (default) or live. live ALSO needs ALPHA_HIVE_ALLOW_LIVE=1 and a confirm in the terminal ---
TRADELOCKER_ENV=demo
ALPHA_HIVE_ALLOW_LIVE=0

# --- Shared secret between the terminal and the bridge (16+ chars). Paste the same value into the terminal. ---
BRIDGE_TOKEN=
BRIDGE_PORT=8765

# --- Hard limits, enforced in the bridge (can be tightened; code ceilings in bridge/settings.py) ---
MAX_RISK_PCT_PER_TRADE=0.5
MAX_POSITION_USD=2000
MAX_POSITION_PCT_OF_BALANCE=20
DAILY_LOSS_STOP_PCT=2
MAX_OPEN_POSITIONS=1
# Crucial's account leverage limit (about 1:30); notional is capped at balance x this
ACCOUNT_MAX_LEVERAGE=30
KILL_SWITCH=0

# Hive coin -> Crucial instrument (defaults: BTC:BTCUSD,ETH:ETHUSD,US30:US30)
SYMBOL_MAP=

# --- Which broker this bridge process talks to: tradelocker (default) or coinbase ---
# If unset, Coinbase is selected only when Coinbase keys are present and TradeLocker login is not.
BRIDGE_BROKER=tradelocker

# --- Coinbase Advanced Trade (CDP secret API key). Coinbase has no demo account. ---
# Default mode is PREVIEW-ONLY: the bridge calls preview_order and never create_order
# until ALPHA_HIVE_ALLOW_LIVE=1 AND you tick "Arm LIVE" in the local terminal.
# Create a trade-only Secret API key at https://portal.cdp.coinbase.com/access/api
# (API keys → Secret API Keys → Create API key):
#   - Permissions: enable View and Trade; leave Transfer and Receive OFF (the key must
#     not be able to withdraw or send funds).
#   - IP allowlist: add this computer's public IP (or your home/WAN IP) so the key
#     only works from here.
#   - Algorithm: Ed25519 (recommended) or ECDSA (ES256). Save the key name and private
#     key when shown — Coinbase will not show the private key again.
# Paste the key name (organizations/.../apiKeys/...) and the private key below.
# For a PEM key, keep the BEGIN/END lines and write newlines as \n inside quotes.
# These values stay in bridge/.env (git-ignored). Never paste them into the browser,
# the repo, chat, or GitHub Pages. Official SDK aliases COINBASE_API_KEY /
# COINBASE_API_SECRET are also accepted.
COINBASE_API_KEY_NAME=
COINBASE_API_PRIVATE_KEY=
# Conservative Coinbase defaults (independent of the TradeLocker limits above):
COINBASE_MAX_POSITION_USD=25
COINBASE_DAILY_LOSS_STOP_USD=5
# COINBASE_MAX_RISK_PCT_PER_TRADE=0.5
# COINBASE_MAX_OPEN_POSITIONS=1
# Coinbase spot is unleveraged; this cannot exceed 1.
# COINBASE_ACCOUNT_MAX_LEVERAGE=1
# Hive coin -> Coinbase product (defaults: BTC:BTC-USD, ETH:ETH-USD, XLM:XLM-USD, ...)
# COINBASE_SYMBOL_MAP=
