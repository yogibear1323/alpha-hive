# Alpha Hive bridge settings. Copy to bridge/.env (never commit it; .env is git-ignored).
# The bridge reads these from the process environment first, then from this file.

# --- Crucial Markets TradeLocker login (the same you use at the TradeLocker web/app login) ---
TRADELOCKER_EMAIL=
TRADELOCKER_PASSWORD=
# The server name shown on the TradeLocker login screen for your Crucial account
TRADELOCKER_SERVER=
# Optional: pick one account if the login has several (id from the account switcher, or accNum)
TRADELOCKER_ACCOUNT_ID=
TRADELOCKER_ACC_NUM=
# Optional TradeLocker developer key (higher rate limits)
TRADELOCKER_DEVELOPER_API_KEY=

# --- Backend: demo (default) or live. live ALSO needs ALPHA_HIVE_ALLOW_LIVE=1 and a confirm in the terminal ---
TRADELOCKER_ENV=demo
ALPHA_HIVE_ALLOW_LIVE=0

# --- Shared secret between the terminal and the bridge (16+ chars). Paste the same value into the terminal. ---
BRIDGE_TOKEN=
BRIDGE_PORT=8765

# --- Hard limits, enforced in the bridge (can be tightened; code ceilings in bridge/settings.py) ---
MAX_RISK_PCT_PER_TRADE=0.5
MAX_POSITION_USD=2000
MAX_POSITION_PCT_OF_BALANCE=20
DAILY_LOSS_STOP_PCT=2
MAX_OPEN_POSITIONS=1
# Crucial's account leverage limit (about 1:30); notional is capped at balance x this
ACCOUNT_MAX_LEVERAGE=30
KILL_SWITCH=0

# Hive coin -> Crucial instrument (defaults: BTC:BTCUSD,ETH:ETHUSD,US30:US30)
SYMBOL_MAP=
