# Copy this file to .env  (macOS/Linux: cp .env.example .env   Windows: Copy-Item .env.example .env)
# Never commit .env, and never paste your key into code, prompts, screenshots, or chat.

# Only needed when MODEL_PROVIDER=GROK. Get one at https://console.x.ai
XAI_API_KEY=

# MOCK = offline deterministic responses (no key, no network). GROK = live xAI API.
MODEL_PROVIDER=MOCK

# The only accepted value. Anything else and run_demo.py exits with code 2.
TRADING_MODE=SIMULATION_ONLY
